{
  "name": "onjeom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/serve-web.mjs",
    "prototype": "node scripts/serve-web.mjs",
    "test": "node --test tests/*.test.mjs prototype/tests/*.test.mjs",
    "check": "tsc --noEmit",
    "export": "expo export --platform ios --platform android",
    "test:browser": "playwright test",
    "format": "prettier --write App.tsx index.js src tests web scripts plugins public *.json *.md playwright*.config.mjs",
    "format:check": "prettier --check App.tsx index.js src tests web scripts plugins public *.json *.md playwright*.config.mjs",
    "test:original": "node --test prototype/tests/*.test.mjs",
    "prototype:original": "cd prototype && node server.mjs",
    "build:ios": "expo run:ios",
    "build:android": "expo run:android",
    "mobile:web": "expo start --web",
    "export:preview": "expo export --platform web --output-dir dist-preview && node scripts/prepare-iphone-web.mjs",
    "test:mobile": "npm run export:preview && playwright test --config playwright.mobile.config.mjs",
    "preview:mobile": "node scripts/serve-mobile-preview.mjs",
    "apk:android": "node scripts/build-preview-apk.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.38",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
